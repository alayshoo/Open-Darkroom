{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Darkroom",
  "version": "0.1.0",
  "identifier": "com.Layshoo.open-darkroom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Open Darkroom",
        "width": 1000,
        "minWidth": 700,
        "height": 800,
        "minHeight": 500,
        "backgroundColor": "#000000",
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
